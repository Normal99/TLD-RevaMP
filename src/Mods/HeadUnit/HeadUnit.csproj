<Project Sdk="Microsoft.NET.Sdk">
  <!-- Example mod for TLD Revamp's multiplayer API: a digital head unit for the radio slot (docs/MODDING-MULTIPLAYER.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HeadUnit</AssemblyName>
    <RootNamespace>HeadUnit</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)../../../lib/*.dll" Private="false" />
    <ProjectReference Include="../../TLDRevamp.Multiplayer/TLDRevamp.Multiplayer.csproj" Private="false" />
  </ItemGroup>
</Project>
