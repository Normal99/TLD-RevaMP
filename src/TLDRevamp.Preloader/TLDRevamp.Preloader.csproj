<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="../../lib/BepInEx.dll" Private="false" />
    <Compile Include="../TLDRevamp/Net/ModActivation.cs" Link="ModActivation.cs" />
    <Compile Include="../TLDRevamp/Net/ModFiles.cs" Link="ModFiles.cs" />
  </ItemGroup>
  <!-- The preloader builds where lib/ has no Mono.Cecil (older TLD Copies source caches):
       it compiles against the same 0.10.4 from NuGet. The local copy is preferred when it exists,
       so a build against the game's own assembly stays byte-identical to the one that ships. -->
  <ItemGroup Condition="Exists('../../lib/Mono.Cecil.dll')">
    <Reference Include="../../lib/Mono.Cecil.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../lib/Mono.Cecil.dll')">
    <PackageReference Include="Mono.Cecil" Version="0.10.4" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
