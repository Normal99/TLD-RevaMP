<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CopyIsolation</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyIsolationLibDir Condition="'$(CopyIsolationLibDir)' == ''">$(MSBuildThisFileDirectory)../../../lib</CopyIsolationLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CopyIsolationLibDir)/*.dll" Private="false" />
  </ItemGroup>
</Project>
