<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TLDInstalls</RootNamespace>
    <AssemblyName>TLDInstalls.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CopyIsolation/CopyIsolation.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained"
                      Condition="'$(CopyIsolationFixture)' != 'true'" />
    <ProjectReference Include="../Installs.Tests.Fixture/Installs.Tests.Fixture.csproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(CopyIsolationFixture)' == 'true'" />
    <InternalsVisibleTo Include="Installs.Tests" />
  </ItemGroup>

  <Target Name="PrepareCopyIsolationResource"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../CopyIsolation/CopyIsolation.csproj"
             Targets="GetTargetPath"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'$(CopyIsolationFixture)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="CopyIsolationResourceOutput" />
    </MSBuild>

    <MSBuild Projects="../Installs.Tests.Fixture/Installs.Tests.Fixture.csproj"
             Targets="GetTargetPath"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'$(CopyIsolationFixture)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="CopyIsolationResourceOutput" />
    </MSBuild>

    <ItemGroup>
      <EmbeddedResource Include="@(CopyIsolationResourceOutput)"
                        LogicalName="TLDInstalls.CopyIsolation.dll"
                        Condition="'$(CopyIsolationFixture)' != 'true'" />
      <EmbeddedResource Include="@(CopyIsolationResourceOutput)"
                        LogicalName="TLDInstalls.CopyIsolation.dll"
                        Condition="'$(CopyIsolationFixture)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>