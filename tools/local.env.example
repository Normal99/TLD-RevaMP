# Machine-specific settings for the test tools. Copy to tools/local.env (gitignored) or ~/.config/tld-revamp/tools.env
# and set what differs on your machine. Environment variables win over this file. Unset = the default shown.

# ---- this machine
# Steam folder (game install and Proton prefix are found under it)
#TLD_STEAM=~/.local/share/Steam
# the game's install folder, if it isn't in Steam's default library
#TLD_DIR=~/.local/share/Steam/steamapps/common/The Long Drive
# the game's Proton prefix (saves, Player.log); default: TLD_TEST_COMPAT/pfx when that is set
#TLD_PREFIX=~/.local/share/Steam/steamapps/compatdata/1017180/pfx
# recommended: the tests' own Proton prefix (a compatdata folder, made on the first launch), so test runs never use or
# change the prefix you play in. The game is then started through Proton directly (Steam must still be running):
#TLD_TEST_COMPAT=~/tld-revamp-testprefix
# the Proton and Steam Linux Runtime folders for that (the ones Steam uses for the game: see its Compatibility setting)
#TLD_PROTON=~/.local/share/Steam/steamapps/common/Proton - Experimental
#TLD_SLR=~/.local/share/Steam/steamapps/common/SteamLinuxRuntime_4
# test runs back up the game's saves here first (keep it outside /tmp: it is wiped on reboot)
#TLD_BACKUPS=~/tld-revamp-backups
# decompiles, game-update diffs and asset scans (never inside the repo or the game folder)
#TLD_CACHE=~/tld-revamp-cache
# ilspycmd (dotnet tool install -g ilspycmd)
#TLD_ILSPY=~/.dotnet/tools/ilspycmd
# other installs gamediff.py compares DLL hashes with (separated by :)
#TLD_ALSO=
# this machine's LAN address, as the second machine reaches it (default: detected from the default route)
#TLD_HOST_IP=

# ---- the second machine (two-machine tests only; leave empty for single-machine work)
# ssh target, user@host. The tools run commands there over ssh (BatchMode: key login, no password prompts).
#TLD_SECOND=me@other-pc
# ssh key for it (empty: ssh's default key and ~/.ssh/config)
#TLD_SSH_KEY=~/.ssh/id_ed25519
# its LAN address, for tests that join it by IP (default: the host part of TLD_SECOND)
#TLD_SECOND_IP=
# its game folder and Proton prefix, as its shell sees them ($HOME expands there)
#TLD_REMOTE_DIR=$HOME/.local/share/Steam/steamapps/common/The Long Drive
#TLD_REMOTE_PREFIX=$HOME/.local/share/Steam/steamapps/compatdata/1017180/pfx
# its Steam folder, and the tests' own prefix / Proton / runtime there (as TLD_TEST_COMPAT, TLD_PROTON, TLD_SLR)
#TLD_REMOTE_STEAM=$HOME/.local/share/Steam
#TLD_REMOTE_TEST_COMPAT=$HOME/tld-revamp-testprefix
#TLD_REMOTE_PROTON=$HOME/.local/share/Steam/steamapps/common/Proton - Experimental
#TLD_REMOTE_SLR=$HOME/.local/share/Steam/steamapps/common/SteamLinuxRuntime_4
