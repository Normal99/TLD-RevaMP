<Project Sdk="Microsoft.NET.Sdk">
  <!-- The offline evidence harness for #39/#40. It links the production mod code and never touches the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>modevidence</AssemblyName>
    <RootNamespace>TLDModEvidence</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Policy.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="Scan.cs" />
    <Compile Include="BepInExCache.cs" />
    <!-- The production code under test: the real lifecycle, not a copy of it. -->
    <Compile Include="../../src/TLDRevamp/Net/ModActivation.cs" />
    <Compile Include="../../src/TLDRevamp/Net/ModFiles.cs" />
    <!-- The production manifest/signature decision: the harness calls it, it does not imitate it. -->
    <Compile Include="../../src/TLDRevamp/Net/ModCatalog.cs" />
  </ItemGroup>
</Project>
