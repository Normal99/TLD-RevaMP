<Project Sdk="Microsoft.NET.Sdk">
  <!-- The runtime no-camera-mutation test (issue #36): it drives the production CinematicRig against Unity
       stubs whose Camera and Transform record EVERY write, and asserts that no gameplay camera is written to
       at all. The worker's own suite checks the state machine; this one checks the property the issue rests on. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems><NoWarn>CS0649;CS8981</NoWarn></PropertyGroup>
  <ItemGroup>
    <Compile Include="CinematicRigIsolationTest.cs" />
    <Compile Include="CinematicRigStubs.cs" />
    <Compile Include="../../src/TLDRevamp/Cinematic/CinematicRig.cs" />
    <Compile Include="../../src/TLDRevamp/Cinematic/CinematicCameraCore.cs" />
  </ItemGroup>
</Project>
